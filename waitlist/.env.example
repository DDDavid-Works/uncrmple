# Web3Forms access key (https://web3forms.com, enter your email to get one).
# Leave empty and the form shows that signups are not open yet instead of pretending to submit.
VITE_WEB3FORMS_ACCESS_KEY=
# Public site URL (no trailing slash). Enables canonical URL, sitemap and og:url.
VITE_SITE_URL=
# Contact shown in the footer, privacy policy, terms and security.txt. Defaults to the address in src/config.ts.
VITE_CONTACT_EMAIL=
